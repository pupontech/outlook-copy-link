<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>a8d04d9e-073e-4cc8-bca7-6fbe42c6a280</Id>
  <Version>1.2.0.0</Version>
  <ProviderName>Rubin IT Consulting</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Copy Email Link"/>
  <Description DefaultValue="Copy a link to the selected email that opens it in Outlook desktop (or on the web), so you can paste it into tickets, Trello cards, notes or chats."/>
  <IconUrl DefaultValue="https://pupontech.github.io/outlook-copy-link/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://pupontech.github.io/outlook-copy-link/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://pupontech.github.io/outlook-copy-link/taskpane.html"/>

  <AppDomains>
    <AppDomain>https://pupontech.github.io/outlook-copy-link</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://pupontech.github.io/outlook-copy-link/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="CopyLinkGroup">
                  <Label resid="Group.Label"/>

                  <!-- Side panel that shows the link, with copy buttons -->
                  <Control xsi:type="Button" id="LinkPaneButton">
                    <Label resid="PaneButton.Label"/>
                    <Supertip>
                      <Title resid="PaneButton.Label"/>
                      <Description resid="PaneButton.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://pupontech.github.io/outlook-copy-link/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://pupontech.github.io/outlook-copy-link/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://pupontech.github.io/outlook-copy-link/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://pupontech.github.io/outlook-copy-link/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Email Link"/>
          <bt:String id="PaneButton.Label" DefaultValue="Link Panel"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="PaneButton.Tip" DefaultValue="Show a link to this email that opens in Outlook desktop, with options to copy it as plain text or as a clickable hyperlink."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
